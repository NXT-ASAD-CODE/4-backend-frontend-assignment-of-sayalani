{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/order", "destination": "/api/index.js" },
    { "source": "/api/products", "destination": "/api/index.js" },
    { "source": "/api/products/:id", "destination": "/api/index.js" },
    { "source": "/api/dashboard/stats", "destination": "/api/index.js" },
    { "source": "/api/health", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}